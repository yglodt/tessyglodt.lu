[Unit]
Description=www.tessyglodt.lu
After=syslog.target

[Service]
User=apps
WorkingDirectory=/applications
# spring.config.location replaces the bundled application.properties: only /etc/tessyglodt.properties is read
ExecStart=/usr/bin/java -Djava.net.preferIPv4Stack=true -Dlog4j2.formatMsgNoLookups=true -jar tessyglodt.jar --spring.config.location=/etc/tessyglodt.properties
SuccessExitStatus=143
TimeoutStopSec=5
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
